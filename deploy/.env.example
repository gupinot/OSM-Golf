# Variables de déploiement. Copier en deploy/.env (non versionné) et renseigner.
# deploy/.env est chargé automatiquement par les scripts deploy/ (via _lib.sh).

# --- Secrets backend (Secret Manager) ---
GEMINI_API_KEY=
OSM_CLIENT_ID=
OSM_CLIENT_SECRET=
AUTHORIZED_EMAILS=

# --- Couche données (Firestore + Cloud Storage) ---
# FIRESTORE_LOCATION : multi-région Firestore (eur3, nam5…). Défaut eur3.
# DATA_BUCKET : nom du bucket géométries+scorecards (défaut PROJECT-data si vide).
# BUCKET_LOCATION : région du bucket (défaut europe-west1, co-localisé Cloud Run).
FIRESTORE_LOCATION=eur3
DATA_BUCKET=
BUCKET_LOCATION=europe-west1

# --- Config Firebase web (valeurs publiques, build frontend) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
