rules_version = '2';

// Accès aux données exclusivement via le backend (Admin SDK, qui contourne ces règles).
// Aucun accès client direct : deny-all fail-closed, cohérent avec l'allowlist backend.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
