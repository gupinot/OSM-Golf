# Config Firebase web (valeurs publiques, non secrètes) — console Firebase >
# Paramètres du projet > Vos applications > SDK setup and configuration.
# Copier ce fichier en .env.local et renseigner les valeurs du projet.
#
# Laisser vide pour désactiver l'auth en dev local (appli ouverte, cf. AUTH_DISABLED côté backend).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
