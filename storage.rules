rules_version = '2';

// Objets (géométries GeoJSON, images de scorecards) servis exclusivement via le backend
// (Admin SDK). Aucun accès client direct : deny-all fail-closed.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
